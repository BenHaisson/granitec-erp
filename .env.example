# Firebase configuration (browser — safe to expose, hence the VITE_ prefix)
# Copy this file to .env / .env.local and fill in your Firebase project values
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ── Cloudflare R2 document storage (SERVER-ONLY) ──────────────────
# Used only by the /api/r2/* serverless functions. NEVER prefix these with
# VITE_ — that would leak the secrets into the browser bundle.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="granitec-erp-documents"

# Firebase Admin service account — the FULL service-account JSON minified to a
# single line (used to verify the caller's Firebase ID token server-side).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: lock storage to a single Firebase user UID. If set, any other
# authenticated user is rejected. Leave blank to allow any signed-in user.
ALLOWED_FIREBASE_UID=

# Optional: maximum upload size in bytes (default 15 MB / 15728640).
MAX_UPLOAD_BYTES="15728640"
